# ──────────────────────────────────────────
# XIRA Backend Configuration
# ──────────────────────────────────────────

# X Layer Testnet RPC
XLAYER_RPC_URL=https://testnet.xlayer.tech

# XIRA Smart Contract (set after deployment)
# Run: ./scripts/deploy-contract.sh
XIRA_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Deployer / Updater private key (without 0x prefix)
# Get testnet OKB: https://www.okx.com/xlayer/faucet
PRIVATE_KEY=

# ──────────────────────────────────────────
# Data Mode
# "true"  = real Yahoo Finance prices + news
# "false" = simulated mock data (always works)
USE_LIVE_DATA=false

# ──────────────────────────────────────────
# AI Configuration
AI_MODE=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Model versioning
MODEL_VERSION=v1.0.0-mvp

# Server
HOST=0.0.0.0
PORT=8000

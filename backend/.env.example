# ──────────────────────────────────────────
# XIRA Backend Configuration
# ──────────────────────────────────────────

# X Layer Testnet RPC
XLAYER_RPC_URL=https://testrpc.xlayer.tech

# XIRA Smart Contract (deployed on-chain)
# Explorer: https://www.okx.com/web3/explorer/xlayer-test/address/0x64288ccD936470f66D7035e824A9141C938C32AE
XIRA_CONTRACT_ADDRESS=0x64288ccD936470f66D7035e824A9141C938C32AE

# Deployer / Updater private key (0x-prefixed)
# Get testnet OKB: https://www.okx.com/xlayer/faucet
PRIVATE_KEY=

# ──────────────────────────────────────────
# Data Mode
# "true"  = real Yahoo Finance prices + news
# "false" = simulated mock data (always works)
USE_LIVE_DATA=false

# ──────────────────────────────────────────
# AI Configuration
AI_MODE=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Model versioning
MODEL_VERSION=v1.0.0-mvp

# Server
HOST=0.0.0.0
PORT=8000

# ──────────────────────────────────────────
# XIRA Backend Configuration
# ──────────────────────────────────────────

# X Layer Mainnet RPC
XLAYER_RPC_URL=https://rpc.xlayer.tech
# Optional fallback RPC (tried if primary is unreachable)
XIRA_RPC_FALLBACK=
# Chain label + explorer base override (testnet example)
# XIRA_CHAIN_LABEL=xlayer-testnet
# XIRA_EXPLORER_BASE=https://www.okx.com/web3/explorer/xlayer-test

# Signer balance alert threshold (native token units; OKB on X Layer)
XIRA_MIN_SIGNER_BALANCE_OKB=0.05

# XIRA Smart Contract (deployed on mainnet)
# Explorer: https://www.okx.com/web3/explorer/xlayer/address/0x22851e160aef3e3aeb373fd351a07ff7c65c9b57
XIRA_CONTRACT_ADDRESS=0x22851e160aef3e3aeb373fd351a07ff7c65c9b57

# Deployer / Updater private key (0x-prefixed)
# Get testnet OKB (for testnet deployments only): https://www.okx.com/xlayer/faucet
PRIVATE_KEY=

# ──────────────────────────────────────────
# Data Mode
# "true"  = real prices (Yahoo) + news (Finnhub rotation)
# "false" = simulated mock data (always works)
USE_LIVE_DATA=false

# Hybrid feeds: quotes/OHLCV from Yahoo (no key); Finnhub only for news.
# XIRA_QUOTE_PROVIDER=yahoo        # yahoo | finnhub | mock
# XIRA_NEWS_PER_PASS=15            # headlines fetched per scheduler pass
XIRA_CATALOG_PATH=../catalogs/asset_catalog.json

# ──────────────────────────────────────────
# On-chain publishing (50 assets)
# XIRA_BATCH_CHUNK=12              # assets per batchUpdateAttestations tx

# ──────────────────────────────────────────
# AI Configuration
AI_MODE=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Model versioning
MODEL_VERSION=v1.0.0

# Server
HOST=0.0.0.0
PORT=8000
